{
  "name": "rollup-plugin-opener",
  "version": "0.2.5",
  "description": "Serve rollup bundle and open in browser",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js"
  },
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "rollup -c --configPlugin typescript",
    "prebuild:types": "rimraf ./types ",
    "build:types": "tsc -p ./tsconfig.build.json && tsc-alias",
    "prod": "pnpm build:types && pnpm build",
    "dev": "rollup -cw --configPlugin typescript --environment NODE_ENV:development",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "cd test && rollup -cw || cd ..",
    "clean": "pnpm pm clean && rm -rf dist types"
  },
  "keywords": [
    "rollup",
    "rollup-plugin",
    "serve",
    "dev-server",
    "static"
  ],
  "license": "MIT",
  "author": "Johan Aarstein <johan@aarstein.media>",
  "homepage": "https://github.com/aarsteinmedia/rollup-plugin-opener",
  "bugs": {
    "url": "https://github.com/aarsteinmedia/rollup-plugin-opener/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aarsteinmedia/rollup-plugin-opener"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "mime": "^4.1.0",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/core": "^1.2.1",
    "@eslint/js": "^10.0.1",
    "@regru/eslint-plugin-prefer-early-return": "^1.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.5.1",
    "@types/opener": "^1.4.3",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-no-restricted": "^0.1.2",
    "eslint-plugin-fsecond": "^1.5.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.3",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-swc3": "^0.12.1",
    "rollup-plugin-typescript-paths": "^1.5.0",
    "tsc-alias": "^1.9.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
